# Örnek ortam değişkenleri. Gerçek değerleri buraya değil, ortam değişkeni olarak verin
# (Windows cmd: set Ad=Değer). Bu dosyaya gerçek anahtar yazıp commit etmeyin.
ConnectionStrings__Default=Server=localhost;Database=CryptoFxTracker;Trusted_Connection=True;TrustServerCertificate=True

# Zorunlu, en az 32 karakter. Yoksa API ve dotnet ef açılmaz.
Jwt__Secret=replace-with-at-least-32-random-characters

# İsteğe bağlı. BotToken yoksa alarm bildirimleri yalnızca loga yazılır.
# BotToken: Telegram'da @BotFather'dan alınır. ChatId: kendi ChatId'si olmayan kullanıcıların
# bildirimlerinin gideceği varsayılan sohbet (sayı). Kullanıcı kendi ChatId'sini
# PUT /api/users/me/telegram ile ayarlayabilir.
Telegram__BotToken=
Telegram__ChatId=
