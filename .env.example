# docker compose için: bu dosyayı .env adıyla kopyalayıp değerleri doldurun (.env git'e girmez).
# Değerler bilerek boş: zorunlu biri boş kalırsa compose net bir hatayla durur.
# Yerelde (Docker'sız) çalıştırırken aynı adları cmd'de ortam değişkeni olarak verin: set Ad=Değer

# Zorunlu (compose). SQL Server yönetici şifresi: en az 8 karakter; büyük harf, küçük harf,
# rakam ve sembolden en az üçünü içermeli, yoksa SQL Server container'ı açılmaz.
# Güvenli semboller: ! @ % ^ * _ - . ; (ör. Gizli_Sifre-2026!)
# KULLANMAYIN: $ (compose bunu değişken sanıp siler), ' ve " (bağlantı dizesini bozar), # ve boşluk.
MSSQL_SA_PASSWORD=

# Zorunlu, en az 32 karakter. Yoksa API açılmaz. $ kullanmayın (compose siler, anahtar kısalır).
# Yalnızca harf ve rakamdan oluşan uzun rastgele bir değer en güvenlisi.
Jwt__Secret=

# İsteğe bağlı. BotToken yoksa alarm bildirimleri yalnızca loga yazılır.
# BotToken: Telegram'da @BotFather'dan alınır. ChatId: kendi ChatId'si olmayan kullanıcıların
# bildirimlerinin gideceği varsayılan sohbet (sayı). Kullanıcı kendi ChatId'sini
# PUT /api/users/me/telegram ile ayarlayabilir.
Telegram__BotToken=
Telegram__ChatId=
